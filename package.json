{
  "name": "agent-eval",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WFXM / dsh-wfxm 共用的 agent 评估与反馈闭环组件",
  "scripts": {
    "eval": "node src/cli.mjs",
    "eval:wfxm": "node src/cli.mjs run --suite baseline --runtime wfxm",
    "eval:repo": "node src/cli.mjs run --suite repo --runtime wfxm",
    "eval:capability": "node src/cli.mjs run --suite capability --runtime wfxm --real",
    "eval:heldout": "node src/cli.mjs run --suite heldout --runtime wfxm --real",
    "eval:rag": "node src/cli.mjs run --suite rag --runtime wfxm --real",
    "eval:butler": "node src/cli.mjs run --suite butler --runtime wfxm-butler",
    "eval:trajectory": "node src/cli.mjs run --suite trajectory --runtime wfxm",
    "eval:legacy": "node src/cli.mjs run --suite legacy --runtime wfxm",
    "eval:mutation": "node scripts/mutation-spotcheck.mjs",
    "eval:matrix": "node src/model-matrix.mjs",
    "eval:butler-open": "node src/cli.mjs run --suite butler-open --runtime wfxm --real",
    "eval:gate": "node src/cli.mjs gate",
    "eval:gate:rag": "node src/cli.mjs gate --with-rag --real --repeats 2",
    "eval:dsh-smoke": "node src/cli.mjs run --suite dsh-smoke --runtime dsh-wfxm",
    "eval:dsh-tools": "node src/cli.mjs run --suite dsh-tools --runtime dsh-wfxm",
    "eval:dsh-capability": "node src/cli.mjs run --suite dsh-capability --runtime dsh-wfxm --real",
    "eval:dsh-repo": "node src/cli.mjs run --suite dsh-repo --runtime dsh-wfxm --real",
    "eval:dsh-conversation": "node src/cli.mjs run --suite dsh-conversation --runtime dsh-wfxm --real",
    "eval:dsh-trajectory": "node src/cli.mjs run --suite dsh-trajectory --runtime dsh-wfxm",
    "eval:dsh-gate": "node src/cli.mjs gate --runtime dsh-wfxm",
    "test:contract": "node --test src/contract.test.mjs",
    "test": "node --test src/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@8.15.9+sha512.499434c9d8fdd1a2794ebf4552b3b25c0a633abcee5bb15e7b5de90f32f47b513aca98cd5cfd001c31f0db454bc3804edccd578501e4ca293a6816166bbd9f81"
}
