          {
            "path": "test/slug.test.mjs",
            "content": "import test from \"node:test\"\nimport assert from \"node:assert\"\nimport { slug } from \"../src/slug.mjs\"\n\ntest(\"slug 折叠空白\", () => assert.equal(slug(\"a  b\"), \"a-b\"))\n"
          }
        ]
      }
    }
  },
  "rubric": {
    "hard": [
      { "id": "fixed", "type": "file_contains", "path": "src/slug.mjs", "text": "-" },
      { "id": "tests", "type": "tests_passed", "command": "node --test --test-reporter=tap test/slug.test.mjs" },
      { "id": "budget", "type": "max_tool_calls", "value": 12 }
    ],
    "soft": {
      "minScore": 4,
      "criteria": ["先读测试再改实现", "修复后测试通过", "不修改测试断言"]
