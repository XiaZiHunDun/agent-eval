            "content": "import { E_CONFLICT } from \"./errors.mjs\"\nexport function run() {\n  throw new Error(E_CONFLICT)\n}\n"
          }
        ]
      }
    }
  },
  "rubric": {
    "hard": [
      { "id": "no-write", "type": "tool_forbidden", "tools": ["write_file"] },
