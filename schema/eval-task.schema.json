{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wfxm.local/schema/eval-task.v0.json",
  "title": "EvalTask v0",
  "description": "任务只描述「用户会怎么说 + 什么算做到」，不描述实现。runtimeHints 封装单个 runtime 的私有装配信息，评估核心不读取。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "suite", "turns"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "suite": { "type": "string", "minLength": 1 },
    "notes": { "type": "string", "description": "迁移来源或人工备注；评估器不读取" },
    "taxonomy": {
      "type": "string",
      "minLength": 1,
      "description": "能力维度，用于分层统计。建议值：code-edit / debug / retrieval / planning / multi-turn / approval-safety / tool-orchestration / robustness"
    },
    "difficulty": {
      "enum": ["easy", "medium", "hard"],
      "description": "难度分级，用于分层报告"
    },
    "source": {
      "enum": ["handwritten", "regression", "online-replay", "public-benchmark"],
      "description": "任务来源：手写 / 回归沉淀 / 线上脱敏回放 / 公开基准改写"
    },
    "split": {
      "enum": ["dev", "test", "held-out"],
      "description": "数据集划分；held-out 不参与调参与提示词迭代"
    },
    "kind": {
      "enum": ["chat", "chat-task", "repo-task"],
      "default": "chat",
      "description": "chat 面向对话/工具行为；repo-task 面向仓库级开发任务，以测试结果为准"
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "messageIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "与 turns 对齐的稳定消息 id；部分 runtime 用于回放"
    },
    "timeoutMs": { "type": "integer", "minimum": 1000 },
    "workspacePaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "需要在执行后回读的工作区相对路径（adapter 使用）"
    },
    "repo": {
      "type": "object",
      "description": "repo-task 的仓库来源；由 runtime adapter 解析为本地夹具",
      "additionalProperties": false,
      "required": ["fixture"],
      "properties": {
        "fixture": { "type": "string", "minLength": 1 }
      }
    },
    "budget": {
      "type": "object",
      "description": "开放式任务的预算上限；maxCostUsd 仅在 runtime 提供成本时生效",
      "additionalProperties": false,
      "properties": {
        "maxTurns": { "type": "integer", "minimum": 1 },
        "maxToolCalls": { "type": "integer", "minimum": 0 },
        "maxCostUsd": { "type": "number", "minimum": 0 },
        "maxModelCalls": { "type": "integer", "minimum": 0 }
      }
    },
    "weights": {
      "type": "object",
      "description": "评分权重；缺省由评估器给出",
      "additionalProperties": false,
      "properties": {
        "task": { "type": "number", "minimum": 0, "maximum": 1 },
        "trace": { "type": "number", "minimum": 0, "maximum": 1 },
        "cost": { "type": "number", "minimum": 0, "maximum": 1 },
        "latency": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "rubric": {
      "type": "object",
      "description": "开放式任务评分：hard 为确定性规则，soft 交给 judge",
      "additionalProperties": false,
      "properties": {
        "hard": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "minLength": 1 },
              "value": {},
              "command": { "type": "string" },
              "path": { "type": "string" },
              "contains": { "type": "string" },
              "pattern": { "type": "string" },
              "equals": { "type": "string" },
              "timeoutMs": { "type": "integer", "minimum": 1000 }
            }
          }
        },
        "soft": {
          "type": "object",
          "properties": {
            "minScore": { "type": "number", "minimum": 0 },
            "criteria": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "hiddenChecks": {
      "type": "array",
      "description": "隐藏检查：在 agent 工作区之外维护，只读取终态文件内容；不得出现在任务可见提示中",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path"],
        "properties": {
          "type": {
            "enum": ["file_exists", "file_absent", "file_equals", "file_contains", "file_matches"]
          },
          "path": { "type": "string", "minLength": 1 },
          "equals": { "type": "string" },
          "contains": { "type": "string" },
          "pattern": { "type": "string" }
        }
      }
    },
    "tamperPolicy": {
      "type": "object",
      "description": "篡改策略：测试、评测配置、隐藏检查默认不可改；agent 只能改动 allowed 中的路径",
      "additionalProperties": false,
      "properties": {
        "allowed": { "type": "array", "items": { "type": "string" } },
        "forbidden": { "type": "array", "items": { "type": "string" } }
      }
    },
    "baselineHash": {
      "type": "string",
      "description": "任务开始时工作区的基线哈希；runtime 支持时用于确认起点未被污染"
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replyPattern": { "type": "string" },
        "finalReplyPattern": { "type": "string" },
        "containsAll": { "type": "array", "items": { "type": "string" } },
        "containsAny": {
          "type": "array",
          "items": { "type": "string" },
          "description": "任一关键词出现在首轮回复即通过；用于无法确定具体措辞的场景"
        },
        "containsNone": { "type": "array", "items": { "type": "string" } },
        "followUpPatterns": { "type": "array", "items": { "type": "string" } },
        "finalDecision": { "type": "string" },
        "finalDecisionIn": { "type": "array", "items": { "type": "string" } },
        "statusIn": { "type": "array", "items": { "type": "integer" } },
        "requireApproval": { "type": "boolean" },
        "minToolCalls": { "type": "integer", "minimum": 0 },
        "maxToolCalls": { "type": "integer", "minimum": 0 },
        "requiredTools": { "type": "array", "items": { "type": "string" } },
        "requiredAnyTools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "等价工具任一即可；与 requiredTools（全部必需）并存，用于 read_file / run_command 这类等价读文件场景"
        },
        "forbiddenTools": { "type": "array", "items": { "type": "string" } },
        "requireToolSuccess": {
          "type": "boolean",
          "description": "为 true 时：若同时声明 toolArgs，则每个期望调用中至少要有一条参数匹配且 ok=true；未声明 toolArgs 时，要求全部工具执行 ok=true。只读结果，不解析轨迹事件本身"
        },
        "toolArgs": {
          "type": "array",
          "description": "每次断言要求存在一次工具调用，名一致且参数是期望对象的递归子集",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "args"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "args": { "type": "object" }
            }
          }
        },
        "workspaceState": {
          "type": "array",
          "description": "执行结束后回读工作区文件（相对工作区根目录）；exists=false 断言文件不存在，其余字段断言内容",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "exists": { "type": "boolean" },
              "equals": { "type": "string" },
              "contains": { "type": "string" },
              "matches": { "type": "string" }
            }
          }
        },
        "tests": {
          "type": "object",
          "description": "仓库任务以测试为 oracle：先跑基线，再跑执行后的测试。failToPass 必须基线失败、终态通过；passToPass 必须两次都通过。",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "failToPass": { "type": "array", "items": { "type": "string" } },
            "passToPass": { "type": "array", "items": { "type": "string" } },
            "timeoutMs": { "type": "integer", "minimum": 1000 }
          }
        },
        "honestStop": {
          "type": "boolean",
          "description": "为 true 时要求明确说明无法完成/需要补充信息，且不得宣称完成或产生副作用"
        },
        "honestStopPatterns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "覆盖默认的诚实停止匹配词（正则）"
        },
        "quality": {
          "type": "object",
          "description": "代码质量硬门禁；依赖 adapter 提供 workspaceChanges",
          "additionalProperties": false,
          "properties": {
            "maxChangedFiles": { "type": "integer", "minimum": 0 },
            "maxDiffLines": { "type": "integer", "minimum": 0 }
          }
        },
        "detector": {
          "type": "object",
          "description": "对抗集专用：评估器识别到预期失败信号时，任务才算通过",
          "additionalProperties": false,
          "properties": {
            "check": { "type": "string" },
            "prefix": { "type": "string" },
            "category": { "type": "string" }
          }
        },
        "userMessage": {
          "type": "object",
          "description": "用户可见消息的结构契约（确定性检查，不做措辞精确匹配）",
          "additionalProperties": false,
          "properties": {
            "mustMention": { "type": "array", "items": { "type": "string" } },
            "mustNotMatch": { "type": "array", "items": { "type": "string" } },
            "maxLength": { "type": "integer", "minimum": 1 }
          }
        },
        "butler": {
          "type": "object",
          "description": "管家层观测（仅 wfxm-butler）",
          "additionalProperties": false,
          "properties": {
            "route": { "type": "string" },
            "rule": { "type": "string" },
            "result": { "type": "object" }
          }
        }
      }
    },
    "runtimeHints": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    }
  }
}
